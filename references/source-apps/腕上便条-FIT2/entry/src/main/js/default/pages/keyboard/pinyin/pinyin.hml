<stack class="stack-container">
    <div class="container" onswipe="onswipe" show="{{ mainshow }}">
        <text class="title">修改数据</text>
        <text class="data">{{ showdata }}</text>
        <div class="all-container">
            <div class="first-container">
                <text class="letters">{{ letters }}:</text>
                <image src="common/left.bin" class="image" onclick="last" style="opacity : {{ left }};"></image>
                <text class="candidate" onclick="addcandidate({{ words[wordsPageIndex] }})">{{ words[wordsPageIndex] }}
                </text>
                <text class="candidate" onclick="addcandidate({{ words[wordsPageIndex + 1] }})">
                    {{ words[wordsPageIndex + 1] }}</text>
                <text class="candidate" onclick="addcandidate({{ words[wordsPageIndex + 2] }})">
                    {{ words[wordsPageIndex + 2] }}</text>
<!--                <text class="candidate" onclick="addcandidate({{ words[wordsPageIndex + 3] }})">-->
<!--                    {{ words[wordsPageIndex + 3] }}</text>-->
<!--                <text class="candidate" onclick="addcandidate({{ words[wordsPageIndex + 4] }})">-->
<!--                    {{ words[wordsPageIndex + 4] }}</text>-->
                <image src="common/right.bin" class="image" onclick="next" style="opacity : {{ right }};"></image>
            </div>
            <div class="button-container">
                <input type="button" class="button" value="{{ letterarray[0] }}"
                       onclick="onclick({{ letterarray[0] }})"></input>
                <input type="button" class="button" value="{{ letterarray[1] }}"
                       onclick="onclick({{ letterarray[1] }})"></input>
                <input type="button" class="button" value="{{ letterarray[2] }}"
                       onclick="onclick({{ letterarray[2] }})"></input>
                <input type="button" class="button" value="{{ letterarray[3] }}"
                       onclick="onclick({{ letterarray[3] }})"></input>
                <input type="button" class="button" value="{{ letterarray[4] }}"
                       onclick="onclick({{ letterarray[4] }})"></input>
                <input type="button" class="button" value="{{ letterarray[5] }}"
                       onclick="onclick({{ letterarray[5] }})"></input>
                <input type="button" class="button" value="{{ letterarray[6] }}"
                       onclick="onclick({{ letterarray[6] }})"></input>
                <input type="button" class="button" value="{{ letterarray[7] }}"
                       onclick="onclick({{ letterarray[7] }})"></input>
                <input type="button" class="button" value="{{ letterarray[8] }}"
                       onclick="onclick({{ letterarray[8] }})"></input>
                <input type="button" class="button" value="{{ letterarray[9] }}"
                       onclick="onclick({{ letterarray[9] }})"></input>
            </div>
            <div class="button-container">
                <input type="button" class="button-2" value="{{ letterarray[10] }}"
                       onclick="onclick({{ letterarray[10] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[11] }}"
                       onclick="onclick({{ letterarray[11] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[12] }}"
                       onclick="onclick({{ letterarray[12] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[13] }}"
                       onclick="onclick({{ letterarray[13] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[14] }}"
                       onclick="onclick({{ letterarray[14] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[15] }}"
                       onclick="onclick({{ letterarray[15] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[16] }}"
                       onclick="onclick({{ letterarray[16] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[17] }}"
                       onclick="onclick({{ letterarray[17] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[18] }}"
                       onclick="onclick({{ letterarray[18] }})"></input>
            </div>
            <div class="button-container">
                <input type="button" class="button-2" value="{{ letterarray[19] }}"
                       onclick="onclick({{ letterarray[19] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[20] }}"
                       onclick="onclick({{ letterarray[20] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[21] }}"
                       onclick="onclick({{ letterarray[21] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[22] }}"
                       onclick="onclick({{ letterarray[22] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[23] }}"
                       onclick="onclick({{ letterarray[23] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[24] }}"
                       onclick="onclick({{ letterarray[24] }})"></input>
                <input type="button" class="button-2" value="{{ letterarray[25] }}"
                       onclick="onclick({{ letterarray[25] }})"></input>
            </div>
            <div class="button-container">
                <input type="button" class="english-button" value="英" grab:click="changeenglish"></input>
                <input type="button" class="delete-button" onclick="delete" onlongpress="deleteall"></input>
            </div>
        </div>
    </div>
    <div class="container" onswipe="exitonswipe" show="{{ exitshow }}">
        <text class="title">提示</text>
        <text class="text">数据尚未保存，在\n退出前要保存\n数据吗？</text>
        <div class="image-container">
            <input class="disagree" grab:click="exit"></input>
            <input class="agree" grab:click="savedata"></input>
        </div>
    </div>
    <image src="common/delete_word.bin" class="delete-image" show="{{ mainshow }}"></image>
</stack>
<stack class="container" onswipe="onSwipe">
    <div class="container">
        <text class="title">{{ showyear }} 年\n{{ showmonth }} 月 {{ showday }} 日</text>
        <text class="text">{{ weekday }} {{ lunarYearCn }}{{ zodiacYear }}年 {{ lunarMonthCn }}{{ lunarDayCn }}</text>
        <text class="text">{{ monthganzhi }}月 {{ dayganzhi }}日 {{ solarTerm }}{{ empty_string }}{{ gregorianterm }}</text>
        <swiper class="yiji-container" loop="false">
            <div class="yiji-container">
                <div class="Yi">
                    <text>宜</text>
                </div>
                <text class="yiji-text">{{ Yi }}</text>
            </div>
            <div class="yiji-container">
                <div class="Ji">
                    <text>忌</text>
                </div>
                <text class="yiji-text">{{ Ji }}</text>
            </div>
        </swiper>
    </div>
</stack>

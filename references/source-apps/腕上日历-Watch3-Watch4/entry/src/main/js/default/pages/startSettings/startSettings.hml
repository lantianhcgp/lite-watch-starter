<div class="container">
    <list class="list-container" rotationvibrate="true" itemscale="false" scrollbar="auto">
        <list-item class="title-item" clickeffect="false">
            <text class="title">选择一个选项</text>
        </list-item>
        <list-item class="radio-item" @click="indexclick">
            <div class="radio-item radio-background">
                <text class="select-text">首页</text>
                <image class="radio" src="/common/radio-{{ indexchecked }}.png"></image>
            </div>
        </list-item>
        <list-item class="radio-item" @click="detailsclick">
            <div class="radio-item radio-background">
                <text class="select-text">详情</text>
                <image class="radio" src="/common/radio-{{ detailschecked }}.png"></image>
            </div>
        </list-item>
        <list-item class="radio-item" @click="festivalclick">
            <div class="radio-item radio-background">
                <text class="select-text">节假日</text>
                <image class="radio" src="/common/radio-{{ festivalchecked }}.png"></image>
            </div>
        </list-item>
        <list-item class="radio-item" @click="solartermclick">
            <div class="radio-item radio-background">
                <text class="select-text">节气</text>
                <image class="radio" src="/common/radio-{{ solartermchecked }}.png"></image>
            </div>
        </list-item>
        <list-item class="radio-item" @click="adjustholidayclick">
            <div class="radio-item radio-background">
                <text class="select-text">调休</text>
                <image class="radio" src="/common/radio-{{ adjustholidaychecked }}.png"></image>
            </div>
        </list-item>
        <list-item class="radio-item" @click="timerclick">
            <div class="radio-item radio-background">
                <text class="select-text">时间进度条</text>
                <image class="radio" src="/common/radio-{{ timerchecked }}.png"></image>
            </div>
        </list-item>
        <list-item class="tips-item" clickeffect="false">
            <text class="tips">选择后每次启动应用，都会自动跳转到您所设置的页面，方便查看对应数据。</text>
        </list-item>
    </list>
</div>
<stack class="container">
    <div class="container">
        <text class="title">跳转到</text>
        <div class="all-container">
            <div class="year-container" @touchstart="clickyear" @click="clickyear">
                <picker-view indicatorsuffix="年" class="year-picker" type="text" range="{{ yearvalue }}" selected="{{ yearcount }}"
                             onchange="yearchange" style="selected-color : {{ yearcolor }};">
                </picker-view>
            </div>
            <div class="month-container" @touchstart="clickmonth" @click="clickmonth">
                <picker-view indicatorsuffix="月" class="month-picker" type="text" range="{{ monthvalue }}" selected="{{ monthcount }}"
                             onchange="monthchange" style="selected-color : {{ monthcolor }};">
                </picker-view>
            </div>
        </div>
        <button class="confirm" type="arc" @click="back" value="确定"></button>
    </div>
</stack>
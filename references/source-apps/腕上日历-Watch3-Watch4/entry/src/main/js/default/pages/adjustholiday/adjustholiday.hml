<stack class="container">
    <div class="container" show="{{ main_if }}">
        <list class="list" updateeffect="true" ref="list" rotationvibrate="true" itemscale="false" scrollbar="auto">
            <list-item class="title-container" clickeffect="false"></list-item>
            <list-item class="list-item" for="{{ content }}" @click="replacedetails({{ $item.content }})">
                <stack class="list-stack">
                    <div class="now" if="{{ $item.show }}"></div>
                    <div class="list-container">
                        <text class="festival">{{ $item.festival }}</text>
                        <text class="content">{{ $item.content }}</text>
                    </div>
                </stack>
            </list-item>
            <list-item class="list-item empty-style" clickeffect="false" for="{{ empty_content }}">
                <text class="empty-text">{{ $item.text }}</text>
            </list-item>
            <list-item class="list-item" clickeffect="false"></list-item>
        </list>
    </div>
    <div class="container">
        <div class="title-container" @click="doNotPropagation">
            <text class="title">调休</text>
            <div class="sub-container">
                <text class="year" @click="showyearselect">{{ showyear }} 年</text>
                <image src="/common/down.png" class="down" @click="showyearselect"></image>
            </div>
        </div>
    </div>
    <div class="container" style="background-color : #66000000;" @click="exit" if="{{ ifyearselect }}">
        <div class="year-container">
            <div class="picker-container">
                <picker-view indicatorsuffix="年" type="text" range="{{ yeararray }}" class="picker"
                             selected="{{ yearselect }}"
                             onchange="yearchange"></picker-view>
            </div>
            <button type="capsule" value="确定" class="button" @click="confirm"></button>
            <button type="capsule" value="返回今年" class="button back" @click="back"></button>
        </div>
    </div>
</stack>

<stack class="stack-container">
    <list class="slider" onscrollbottom="sliderchange(1)" rotationvibrate="true">
        <list-item class="slider-item" clickeffect="false"></list-item>
    </list>
    <stack class="stack-container" onswipe="touchMove">
        <div class="container">
            <text class="text" @click="replacemore">{{ year }} 年 {{ month }} 月</text>
            <div class="image-container">
                <text class="dayfont" @click="replacedetails">{{ day }}</text>
                <image src="/common/blue/daytext.png" class="daytext"></image>
            </div>
            <div class="text-container">
                <text>{{ weekday }}</text>
                <text class="nongliyear">{{ lunarYearCn }}{{ zodiacYear }}年</text>
                <text class="nongliday">{{ lunarMonthCn }}{{ lunarDayCn }}</text>
            </div>
            <div class="term-container" show="{{ showterm }}">
                <text class="nonglijijie" show="{{ solarTermshow }}" @click="solarterm">{{ solarTerm }}</text>
                <text class="gregorianterm" show="{{ showgregorianterm }}" @click="festival">{{ gregorianterm }}
                </text>
            </div>
        </div>
        <image src="/common/up.png" class="up"></image>
    </stack>
    <div class="tips-container" show="{{ tips_show }}">
        <text class="tips">向左滑动可以查看更多功能</text>
        <image src="/common/gesture.png" class="gesture"></image>
        <input type="button" class="ok" @click="tips" value="我知道了"></input>
    </div>
</stack>
<stack class="stack-container" @swipe="touchMove">
    <div class="container">
        <text class="title" onlongpress="jumpto">{{ year }} 年 {{ month }} 月</text>
        <div class="week-container">
            <text class="week-text">一二三四五六日</text>
        </div>
        <div class="day-container">
            <text class="text" style="background-color : {{ $item.d == day && nowyear == year && nowmonth == month ? '#bf00bfff' : '#00ffffff' }};" for="{{ date_content }}" @click="watchdate($item.d)">{{ $item.d }}</text>
        </div>
    </div>
    <div class="more-container" click-effect="spring-small" onclick="replacemore">
        <image src="/common/more.png" class="more"></image>
        <text class="more-text" onclick="replacemore">更多</text>
    </div>
    <div class="right" click-effect="spring-small" if="{{ right_if }}" @click="swipeleft">
        <image src="/common/right.png" class="image"></image>
    </div>
    <div class="left" click-effect="spring-small" if="{{ left_if }}" @click="swiperight">
        <image src="/common/left.png" class="image"></image>
    </div>
    <slider class="slider" max="1" ref="slider" value="1" on:change="sliderchange"></slider>
</stack>
<div class="page">
    <div class="header-bar">
        <text class="page-title">&#x8bfe;&#x7a0b;&#x8be6;&#x60c5;</text>
    </div>
    <div class="color-bar" style="background-color: {{ color }};"></div>
    <list class="detail-list" ref="detailList">
        <list-item class="detail-name-item">
            <text class="detail-name">{{ courseName }}</text>
        </list-item>
        <list-item class="detail-item">
            <text class="detail-label">&#x661f;&#x671f;</text>
            <text class="detail-value">{{ dayName }}</text>
        </list-item>
        <list-item class="detail-item">
            <text class="detail-label">&#x65f6;&#x95f4;</text>
            <text class="detail-value">{{ timeRange }} ({{ periodText }})</text>
        </list-item>
        <list-item class="detail-item">
            <text class="detail-label">&#x6559;&#x5e08;</text>
            <text class="detail-value">{{ teacher }}</text>
        </list-item>
        <list-item class="detail-item">
            <text class="detail-label">&#x5468;&#x6b21;</text>
            <text class="detail-value">{{ weekTypeText }}</text>
        </list-item>
        <list-item class="action-item" @click="onEdit">
            <div class="action-btn edit-btn">
                <text class="action-btn-text">&#x7f16;&#x8f91;</text>
            </div>
        </list-item>
        <list-item class="action-item" @click="onDelete">
            <div class="action-btn del-btn">
                <text class="action-btn-text">&#x5220;&#x9664;</text>
            </div>
        </list-item>
        <list-item class="bottom-space"></list-item>
    </list>
    <div class="bottom-bar">
        <div class="back-btn" @click="onBack">
            <text class="back-btn-text">&#x8fd4;&#x56de;</text>
        </div>
    </div>
    <div class="overlay" if="{{ showDeleteConfirm }}">
        <div class="dialog">
            <text class="dialog-title">&#x786e;&#x8ba4;&#x5220;&#x9664;&#xff1f;</text>
            <input type="button" class="dialog-btn dialog-cancel" value="&#x53d6;&#x6d88;" onclick="onCancelDelete"></input>
            <input type="button" class="dialog-btn dialog-confirm" value="&#x5220;&#x9664;" onclick="onConfirmDelete"></input>
        </div>
    </div>
</div>